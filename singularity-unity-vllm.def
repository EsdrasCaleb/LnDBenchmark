Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:/opt/Unity:${PATH}"
    # Garante que o container encontre as bibliotecas do CUDA e do llama.cpp
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH}"
    export HF_HOME="/tmp/huggingface"
    export PYTHONUNBUFFERED=1

%files
    /home/caleb/gameprojects/unityprojects/LnDBenchmark/unity_installs/Unity-6000.3.11f1.tar.xz /opt/installers/unity.tar.xz
    in_container/orchestrator.py /app/orchestrator.py
    in_container/parse_results.py /app/parse_results.py
    in_container/utils.py /app/utils.py
    in_container/pipeline.sh /app/pipeline.sh

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Atualização de pacotes e dependências (incluindo git, cmake e build-essential)
    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        curl \
        wget \
        p7zip-full \
        unzip \
        xvfb \
        ca-certificates \
        xxd \
        build-essential \
        cmake \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libgtk-3-0 \
        libgconf-2-4 \
        libnss3 \
        libxss1 \
        libasound2 \
        libxtst6 \
        libxshmfence1 \
        libgbm1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxrandr2 \
        libxrender1 \
        libxi6 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libsecret-1-0

    # 2. Extração do Unity
    mkdir -p /opt/Unity
    tar -xJf /opt/installers/unity.tar.xz \
        -C /opt/Unity \
        --strip-components=1

    rm -rf /opt/installers
    rm -f /tmp/unity.tar.xz

    # 3. Python venv e pacotes necessários
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/venv/bin/pip install --no-cache-dir \
        huggingface_hub \
        pandas \
        requests \
        psutil \
        nvidia-ml-py

    # 🔥 4. COMPILAÇÃO NATIVA DO LLAMA.CPP COM SUPORTE A CUDA 12
    echo "========================================================="
    echo "🔨 Baixando e Compilando llama.cpp nativo com CUDA 12..."
    echo "========================================================="
    cd /tmp
    git clone --depth 1 --branch b9673 https://github.com/ggml-org/llama.cpp.git
    cd llama.cpp

    # 1. Configura as flags e define ONDE a instalação final deve ser guardada
    mkdir build
    cd build
    cmake .. -DGGML_CUDA=ON -DCMAKE_INSTALL_PREFIX=/opt/llama-binaries

    # 2. Compila usando todos os núcleos disponíveis
    cmake --build . --config Release -j$(nproc)

    # 3. O comando mágico do CMake que organiza tudo lindo em /opt/llama-binaries
    echo "📦 Instalando e organizando binários em /opt/llama-binaries..."
    cmake --install .

    # 4. Agora sim, copiamos o conteúdo limpo e organizado para as pastas do sistema
    cp /opt/llama-binaries/bin/* /usr/local/bin/

    # Copia as bibliotecas compartilhadas (.so) se elas existirem
    if [ -d "/opt/llama-binaries/lib" ]; then
        cp -r /opt/llama-binaries/lib/* /usr/local/lib/ 2>/dev/null || true
    fi
    if [ -d "/opt/llama-binaries/lib64" ]; then
        cp -r /opt/llama-binaries/lib64/* /usr/local/lib/ 2>/dev/null || true
    fi

    ldconfig || true

    # Limpa apenas a sujeira do código-fonte (/tmp)
    rm -rf /tmp/llama.cpp

    # Agora limpamos apenas a pasta de código-fonte (/tmp/llama.cpp),
    # mas todos os binários finais gerados estão salvos e isolados em /opt/llama-binaries!
    rm -rf /tmp/llama.cpp

    # Limpeza do gerenciador de pacotes
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash /app/pipeline.sh "$@"