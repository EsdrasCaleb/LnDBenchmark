Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:/opt/Unity:${PATH}"
    # Garante que o container encontre as bibliotecas do CUDA e do llama.cpp
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH}"
    export HF_HOME="/tmp/huggingface"
    export PYTHONUNBUFFERED=1

%files
    /home/caleb/gameprojects/unityprojects/LnDBenchmark/unity_installs/Unity-6000.3.11f1.tar.xz /opt/installers/unity.tar.xz
    in_container/orchestrator.py /app/orchestrator.py
    in_container/parse_results.py /app/parse_results.py
    in_container/utils.py /app/utils.py
    in_container/pipeline.sh /app/pipeline.sh

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Atualização de pacotes e dependências (incluindo git, cmake e build-essential)
    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        curl \
        wget \
        p7zip-full \
        unzip \
        xvfb \
        ca-certificates \
        xxd \
        build-essential \
        cmake \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libgtk-3-0 \
        libgconf-2-4 \
        libnss3 \
        libxss1 \
        libasound2 \
        libxtst6 \
        libxshmfence1 \
        libgbm1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxrandr2 \
        libxrender1 \
        libxi6 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libsecret-1-0

    # 2. Extração do Unity
    mkdir -p /opt/Unity
    tar -xJf /opt/installers/unity.tar.xz \
        -C /opt/Unity \
        --strip-components=1

    rm -rf /opt/installers
    rm -f /tmp/unity.tar.xz

    # 3. Python venv e pacotes necessários
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/venv/bin/pip install --no-cache-dir \
        huggingface_hub \
        pandas \
        requests \
        psutil \
        nvidia-ml-py

    # 🔥 4. COMPILAÇÃO NATIVA DO LLAMA.CPP COM SUPORTE A CUDA 12
    echo "========================================================="
    echo "🔨 Baixando e Compilando llama.cpp nativo com CUDA 12..."
    echo "========================================================="
    cd /tmp
    # Baixa a tag estável equivalente à b9673 que você estava usando
    git clone --depth 1 --branch b9673 https://github.com/ggml-org/llama.cpp.git
    cd llama.cpp

    # Configura o CMake para usar CUDA de forma explícita
    mkdir build
    cd build
    cmake .. -DGGML_CUDA=ON

    # Compila usando todos os núcleos disponíveis
    cmake --build . --config Release -j$(nproc)

    # ✅ Mantém a sua lógica inteligente, mas filtrada apenas para a pasta de binários finais!
    find bin/ -type f -executable -exec cp {} /usr/local/bin/ \;

    # Faz o mesmo para as bibliotecas compartilhadas (.so) que o CUDA gera
    find . -type f -name "*.so*" -exec cp {} /usr/local/lib/ \;
    ldconfig || true

    # Limpeza dos arquivos de build para reduzir o tamanho da imagem final
    rm -rf /tmp/llama.cpp

    # Limpeza do gerenciador de pacotes
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash /app/pipeline.sh "$@"