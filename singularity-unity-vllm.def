Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:/opt/Unity:${PATH}"
    # Garante que o container encontre as bibliotecas do CUDA e do llama.cpp
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH}"
    export HF_HOME="/tmp/huggingface"
    export PYTHONUNBUFFERED=1

%files
    /home/caleb/gameprojects/unityprojects/LnDBenchmark/unity_installs/Unity-6000.3.11f1.tar.xz /opt/installers/unity.tar.xz
    /home/caleb/gameprojects/unityprojects/LnDBenchmark/unity_installs/llama-b11146-bin-ubuntu-cuda-12.8-x64.tar.gz /opt/installers/llama.tar.gz
    in_container/orchestrator.py /app/orchestrator.py
    in_container/parse_results.py /app/parse_results.py
    in_container/utils.py /app/utils.py
    in_container/pipeline.sh /app/pipeline.sh

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Atualização de pacotes e dependências essenciais
    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        curl \
        wget \
        p7zip-full \
        unzip \
        xvfb \
        ca-certificates \
        xxd \
        build-essential \
        libgl1-mesa-glx \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libgtk-3-0 \
        libgconf-2-4 \
        libnss3 \
        libxss1 \
        libasound2 \
        libxtst6 \
        libxshmfence1 \
        libgbm1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxrandr2 \
        libxrender1 \
        libxi6 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libsecret-1-0

    # 2. Extração do Unity
    mkdir -p /opt/Unity
    tar -xJf /opt/installers/unity.tar.xz \
        -C /opt/Unity \
        --strip-components=1

    # 3. Python venv e pacotes necessários
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/venv/bin/pip install --no-cache-dir \
        huggingface_hub \
        pandas \
        requests \
        psutil \
        nvidia-ml-py

    # ⚡ 4. INSTALAÇÃO LOCAL DO LLAMA.CPP A PARTIR DO PACOTE PRÉ-BAIXADO
    echo "========================================================="
    echo "⚡ Extraindo llama.cpp do arquivo local..."
    echo "========================================================="
    
    mkdir -p /tmp/llama_extract
    tar -xzf /opt/installers/llama.tar.gz -C /tmp/llama_extract

    # Move executáveis (llama-server, llama-cli, etc.) para /usr/local/bin
    find /tmp/llama_extract -type f -executable -exec cp -f {} /usr/local/bin/ \;

    # Copia bibliotecas compartilhadas (.so*) para /usr/local/lib
    find /tmp/llama_extract -type f -name "*.so*" -exec cp -f {} /usr/local/lib/ \;

    ldconfig || true

    # 5. Limpeza de instaladores e temporários
    rm -rf /opt/installers
    rm -rf /tmp/llama_extract

    # Limpeza do gerenciador de pacotes
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash /app/pipeline.sh "$@"