# 1. Base oficial da NVIDIA com ferramentas de desenvolvimento (Devel) 
# Necessária para compilar o llama.cpp com suporte a placas de vídeo
FROM nvidia/cuda:12.6.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Configura os caminhos do compilador CUDA
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# 2. Instala Python, ferramentas de compilação (Cmake/gcc) e dependências da Unity/Chromium
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    p7zip-full \
    unzip \
    xvfb \
    ca-certificates \
    xxd \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    libglib2.0-0 \
    libgtk-3-0 \
    libgconf-2-4 \
    libnss3 \
    libxss1 \
    libasound2 \
    libxtst6 \
    libxshmfence1 \
    libgbm1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxrandr2 \
    libxrender1 \
    libxi6 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libsecret-1-0 \
    && rm -rf /var/lib/apt/lists/*

# 3. COMPILAÇÃO DO LLAMA.CPP COM SUPORTE A GPU (Híbrido)
# A flag GGML_CUDA=on avisa o instalador para buildar com suporte a NVIDIA.
# O pacote [server] instala a API compatível com o OpenAI (exatamente igual ao vLLM fazia)
ENV GGML_CUDA=on
RUN pip3 install --no-cache-dir llama-cpp-python[server] huggingface_hub pandas requests

# 4. Instalação da Unity utilizando o Changeset correto
RUN mkdir -p /tmp/unity-download \
    && curl -fSL -o /tmp/unity-download/unity.tar.xz https://download.unity3d.com/download_unity/3000ef702840/LinuxEditorInstaller/Unity-6000.3.11f1.tar.xz \
    && mkdir -p /opt/Unity \
    && tar -xJf /tmp/unity-download/unity.tar.xz -C /opt/Unity --strip-components=1 \
    && rm -rf /tmp/unity-download

ENV PATH="/opt/Unity:${PATH}"
ENV HF_HOME="/tmp/huggingface"

WORKDIR /app

# 5. Puxa os seus scripts de análise para dentro do container
COPY in_container/orchestratorLlama.py /app/orchestrator.py
COPY in_container/parse_results.py /app/parse_results.py
COPY in_container/pipeline.sh /app/pipeline.sh
RUN chmod +x /app/pipeline.sh